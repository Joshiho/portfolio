<!DOCTYPE html><html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>University Postgraduate School</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; }
    header { background: #003366; color: white; padding: 15px; text-align: center; }
    nav { background: #0055aa; padding: 10px; text-align: center; }
    nav a { color: white; margin: 0 10px; text-decoration: none; }
    .hero { padding: 40px; text-align: center; background: #f4f4f4; }
    .container { padding: 20px; }
    form { max-width: 500px; margin: auto; }
    input, select, textarea { width: 100%; padding: 10px; margin: 8px 0; }
    button { background: #003366; color: white; padding: 10px; border: none; cursor: pointer; }
    .error { color: red; font-size: 14px; }
  </style>
</head>
<body><header>
  <h1>University Postgraduate School</h1>
  <p>Excellence in Advanced Studies</p>
</header><nav>
  <a href="#">Home</a>
  <a href="#form">Referee Registration</a>
</nav><section class="hero">
  <h2>Welcome to the Postgraduate School</h2>
  <p>Apply for Masters and PhD programs and connect with academic referees.</p>
</section><div class="container" id="form">
  <h2>Referee Registration Form</h2>
  <form id="refereeForm">
    <label>Full Name</label>
    <input type="text" id="name" required><label>Institution</label>
<input type="text" id="institution" required>

<label>Official Email</label>
<input type="email" id="email" required>
<div id="emailError" class="error"></div>

<label>Position</label>
<input type="text" id="position" required>

<label>Phone Number</label>
<input type="tel" id="phone" required>

<button type="submit">Submit</button>

  </form>
</div><script>
  const form = document.getElementById('refereeForm');
  const emailInput = document.getElementById('email');
  const emailError = document.getElementById('emailError');

  form.addEventListener('submit', function(e) {
    const email = emailInput.value.toLowerCase();

    // Disallowed personal domains
    const personalDomains = [
      'gmail.com', 'yahoo.com', 'hotmail.com', 'outlook.com'
    ];

    const domain = email.split('@')[1];

    if (personalDomains.includes(domain)) {
      e.preventDefault();
      emailError.textContent = 'Please use an official institutional email address (no Gmail, Yahoo, etc).';
    } 
    else {
      emailError.textContent = '';
      alert('Form submitted successfully!');
    }
  });
</script></body>
</html>
